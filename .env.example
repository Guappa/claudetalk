# Discord application bot token (Developer Portal > your app > Bot > Reset Token)
DISCORD_BOT_TOKEN=

# The one server the bot will answer in (right-click the server > Copy Server ID)
DISCORD_GUILD_ID=

# Required. Who owns this bridge, comma separated. Owners have full access, can
# never be removed from Discord, and are the only ones who may add an operator.
# Set here on the host so nothing inside Discord can change it. Turn on Discord's
# Settings > Advanced > Developer Mode, right-click yourself, Copy User ID.
DISCORD_OWNER_IDS=

# Root folder new conversations are created under when no path is given
PROJECTS_ROOT=

# Optional: path to the claude executable if it is not on PATH
CLAUDE_BIN=

# Optional: restrict the bot to one category, so several bridges can share a server
DISCORD_CATEGORY_ID=


# Optional: parent folder for per-operator workspaces. Required before other
# operators can create conversations; each gets WORKSPACES_ROOT/<their-user-id>.
WORKSPACES_ROOT=

# Optional: where operators added with /operator are stored
OPERATORS_PATH=data/operators.json

# Optional: where channel bindings are stored
BINDINGS_PATH=data/conversations.json

# Ask an owner in Discord before Claude runs a command, edits a file, or fetches
# the web. Reading the working directory is never gated. false runs every turn
# without asking, which is what a conversation you drive yourself usually wants.
CLAUDE_TOOL_APPROVALS=false
