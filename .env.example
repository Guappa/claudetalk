# Discord application bot token (Developer Portal > your app > Bot > Reset Token)
DISCORD_BOT_TOKEN=

# The one server the bot will answer in (right-click the server > Copy Server ID)
DISCORD_GUILD_ID=

# Required. Who owns this bridge, comma separated. Owners have full access, can
# never be removed from Discord, and are the only ones who may add an operator.
# Set here on the host so nothing inside Discord can change it. Turn on Discord's
# Settings > Advanced > Developer Mode, right-click yourself, Copy User ID.
DISCORD_OWNER_IDS=

# Root folder new conversations are created under when no path is given
PROJECTS_ROOT=

# Optional: path to the claude executable if it is not on PATH
CLAUDE_BIN=

# Optional: the category new conversation channels are created in. It only files them.
DISCORD_CATEGORY_ID=


# Optional: parent folder for per-operator workspaces. Required before other
# operators can create conversations; each gets WORKSPACES_ROOT/<their-user-id>.
WORKSPACES_ROOT=

# Optional: the language the bridge itself speaks: en, de, es, fr, sv or zh.
# Claude still answers in whatever language you write to it. /language changes this from
# Discord, and a pick made there wins over this value from then on.
BRIDGE_LANGUAGE=en

# Optional: where channel bindings are stored; every other state file lives in the same folder
BINDINGS_PATH=data/conversations.json

# Optional: where operators added with /operator are stored, by default beside the bindings
OPERATORS_PATH=data/operators.json

# Ask an owner in Discord before Claude runs a command, edits a file, or fetches
# the web. Reading the working directory is never gated. false runs every turn
# without asking, which is what a conversation you drive yourself usually wants.
CLAUDE_TOOL_APPROVALS=false

# Optional: how many seconds you may have been away from a turn before its
# answer, a failure, a question or an approval request pings you. A turn you are
# following never pings. 0 turns the pings off.
PING_AFTER_SECONDS=120

# Optional: once a day the bridge reads this repository's tags on GitHub, and
# says when a newer version is out: in its log, in /whoami, and to an owner in
# Discord at most once a week. Nothing is downloaded or installed. false makes
# no such request.
UPDATE_CHECK=true

# Optional: what a turn is refused outright, approvals on or off. All six rules
# are on unless this names fewer; "none" switches them all off. The rules:
#   deletes       a recursive delete reaching outside the working directory;
#                 an owner is asked in Discord and may allow that one command
#   force-push    a force push to main or master, or deleting that branch
#   secrets       a write under ~/.ssh, to Claude Code's login file, or to the
#                 bridge's own .env and data folder: by an edit tool always, by
#                 a shell command in its obvious forms (>, cp, sed -i, ...)
#   keys          a read of a private key or of Claude Code's login file, by
#                 the Read tool always, by a shell command when it names one
#   download-run  a download piped straight into a shell (curl ... | sh)
#   machine       shutdown, reboot, mkfs, diskpart, format, dd to a device
# A guard against an accident, not a fence: a model can spell the same thing
# another way. Downloads to a file, npm install and the like are untouched.
# TOOL_DENIALS=deletes,force-push,secrets,keys,download-run,machine
