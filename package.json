{
  "name": "claudetalk",
  "version": "0.15.0",
  "description": "Reach Claude Code sessions on your own machine from Discord, on any device",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --env-file-if-exists=.env --experimental-strip-types src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "stop": "node scripts/stop.mjs",
    "stop:now": "node scripts/stop.mjs --now",
    "check:private": "node scripts/scan-private.mjs",
    "release:notes": "node scripts/release-notes.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "discord.js": "^14.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
